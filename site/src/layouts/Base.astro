---
import '../styles/global.css';
import { SITE, COMPANY, NAV, YOUTUBE, SUPABASE_REF } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  /** JSON-LD 를 추가로 붙일 때 */
  schema?: Record<string, unknown> | Record<string, unknown>[];
  /** 로그인 뒤에만 뜻이 있는 화면 — 색인시키지 않는다 */
  noindex?: boolean;
  /** 카톡·슬랙에 붙였을 때 뜨는 그림. 글에서는 표지 사진을 넘긴다. */
  image?: string;
}

const {
  title,
  description = SITE.description,
  schema,
  noindex = false,
  image = '/og.png',
} = Astro.props;
/** og:image 는 절대 주소여야 한다 — 상대 경로면 대부분의 서비스가 그림을 못 찾는다. */
const ogImage = new URL(image, SITE.url).href;
/** 크기는 기본 카드일 때만 밝힌다. 글 표지는 비율이 제각각이라 잘못 적으면 오히려 어긋난다. */
const ogSized = image === '/og.png';
const fullTitle = title ? `${title} · ${SITE.name}` : `${SITE.name} · ${SITE.tagline}`;
/**
 * 현재 경로. build.format: 'file' 이라 빌드 산출물에서는 `/about.html` 로 들어온다.
 * 개발 서버(`/about`)와 값이 달라 그대로 비교하면 구역 판정이 빌드에서만 어긋난다.
 * 확장자와 index, 끝 슬래시를 걷어내고 하나로 맞춘다.
 */
const path =
  Astro.url.pathname
    .replace(/\/index\.html$/, '/')
    .replace(/\.html$/, '')
    .replace(/(.)\/$/, '$1') || '/';
/**
 * canonical 은 반드시 정리한 경로로 만든다.
 * pathname 을 그대로 쓰면 `/about.html` 이 박히는데, 사이트맵은 `/about` 을 싣는다.
 * 둘이 어긋나면 검색엔진에 같은 문서를 두 주소로 알리는 셈이 된다.
 */
const canonical = new URL(path, SITE.url).href.replace(/(.)\/$/, '$1');

const org = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${SITE.url}#org`,
  name: SITE.name,
  url: SITE.url,
  description: SITE.description,
  logo: `${SITE.url}/og.png`,
  // 외부 프로필을 걸어 둔다. 검색·LLM 이 같은 주체로 묶는 근거가 된다.
  sameAs: [YOUTUBE.url, COMPANY.site],
  parentOrganization: { '@type': 'Organization', name: COMPANY.name, url: COMPANY.site },
};

/**
 * WebSite 는 홈에만 한 번. 이게 없으면 검색결과의 사이트 이름이 도메인이나
 * 엉뚱한 문자열로 잡힌다. 사이트에 검색 기능이 없으므로 SearchAction 은 넣지 않는다.
 */
const website =
  path === '/'
    ? {
        '@context': 'https://schema.org',
        '@type': 'WebSite',
        '@id': `${SITE.url}#website`,
        name: SITE.name,
        alternateName: '커널 아카데미',
        url: SITE.url,
        inLanguage: 'ko',
        publisher: { '@id': `${SITE.url}#org` },
      }
    : null;

/**
 * 하위 페이지의 위계. 경로를 그대로 빵부스러기로 만든다.
 * 이름은 NAV 에서 찾고, 없으면 페이지 제목을 쓴다.
 */
const segs = path.split('/').filter(Boolean);
const navLabel = (href: string): string | undefined => {
  for (const n of NAV) {
    if (n.href === href) return n.label;
    for (const c of (n as any).children ?? []) if (c.href === href) return c.label;
  }
  return undefined;
};
const breadcrumb =
  segs.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: '홈', item: SITE.url },
          ...segs.map((_, i) => {
            const href = '/' + segs.slice(0, i + 1).join('/');
            return {
              '@type': 'ListItem',
              position: i + 2,
              name: navLabel(href) ?? (i === segs.length - 1 ? (title ?? href) : segs[i]),
              item: SITE.url + href,
            };
          }),
        ],
      }
    : null;

const schemas = [
  org,
  ...(website ? [website] : []),
  ...(breadcrumb ? [breadcrumb] : []),
  ...(schema ? (Array.isArray(schema) ? schema : [schema]) : []),
];

/** 하위 메뉴는 감추지 않는다. 지금 서 있는 구역의 하위 항목이 늘 두 번째 줄에 보인다. */
const navItems = NAV.map((item) => ({
  ...item,
  key: item.href.replace(/\W+/g, '') || 'home',
  children: 'children' in item ? item.children : undefined,
  active: path === item.href || path.startsWith(item.href + '/'),
}));
/**
 * 하위 메뉴는 "지금 서 있는 구역"의 것만 띄운다.
 *
 * 호버로 열면 마우스가 메뉴에서 바로 내려가는 순간 :hover 가 풀려 바가 사라지고,
 * 나타났다 없어지면서 본문까지 밀린다. 호버를 쓰지 않으면 늘 같은 자리에 있고
 * 언제든 누를 수 있다.
 */
const activeWithChildren = navItems.find((i) => i.active && i.children?.length);

/**
 * 로그인 여부 표시용.
 *
 * supabase-js 를 모든 페이지에 싣지 않으려고 브라우저 저장소 키만 직접 본다.
 * 여기서 필요한 판단은 "표시를 「로그인」으로 할까 「내 정보」로 할까" 하나뿐이고,
 * 실제 검증은 어차피 각 화면과 DB 정책이 다시 한다. 토큰이 만료됐다면
 * /me 로 들어간 뒤 로그인 화면으로 되돌아가므로 틀려도 손해가 없다.
 */
const authKey = `sb-${SUPABASE_REF}-auth-token`;

/**
 * 콘텐츠 보안 정책.
 *
 * GitHub Pages 는 응답 헤더를 못 넣으므로 meta 로만 건다. meta 로는
 * frame-ancestors·report-uri 를 쓸 수 없다 — 즉 다른 사이트가 이 쪽을 iframe 으로
 * 감싸는 것은 여기서 막지 못한다. 그건 호스팅을 옮겨야 풀리는 문제다.
 *
 * 개발 서버에서는 걸지 않는다. HMR 이 웹소켓으로 붙는데 default-src 'self' 가
 * 그것을 끊어 버려, 고칠 때마다 새로고침해야 한다.
 * 실제 정책은 `npm run preview` 로 확인한다.
 */
const csp = [
  "default-src 'self'",
  "base-uri 'self'",
  "object-src 'none'",
  "frame-src 'none'",
  "img-src 'self' data:",
  "font-src 'self'",
  // 컴포넌트 스타일이 작으면 Astro 가 HTML 안에 넣는다. 스타일 인라인은
  // 스크립트 인라인과 달리 실행 경로가 아니라 위험이 크게 다르다.
  "style-src 'self' 'unsafe-inline'",
  "script-src 'self'",
  // 로그인·자료 목록이 Supabase 로 직접 붙는다. 그 한 곳만 연다.
  `connect-src 'self' https://${SUPABASE_REF}.supabase.co`,
  "form-action 'self'",
  'upgrade-insecure-requests',
].join('; ');
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {import.meta.env.PROD && <meta http-equiv="Content-Security-Policy" content={csp} />}
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}

    {/* 직접 호스팅하는 폰트. 같은 출처라 preconnect 도, 제3자 왕복도 없다. */}
    <link rel="stylesheet" href="/fonts/fonts.css" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="ko_KR" />
    <meta property="og:image" content={ogImage} />
    {
      ogSized && (
        <>
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
        </>
      )
    }
    <meta property="og:image:alt" content={title ?? SITE.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <link rel="alternate" type="application/rss+xml" title={SITE.name} href="/rss.xml" />
    {/* 실제 파일로 둔다. data URI 만 두면 /favicon.ico 가 404 라, 루트 파비콘만
        찾는 크롤러·리더에는 아이콘이 없는 사이트가 된다. */}
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/icon-192.png" />
    {schemas.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  </head>

  <body>
    <a class="skip" href="#main">본문으로 건너뛰기</a>

    <header class="site-head">
      <div class="brandbar">
        <a class="brand" href="/">{SITE.name}</a>
        <a class="userlink" id="userlink" href="/login" data-authkey={authKey} hidden>로그인</a>
      </div>

      {/*
        인라인으로 두지 않는 이유: 인라인 스크립트를 허용하려면 CSP 에
        script-src 'unsafe-inline' 을 열어야 하고, 그러면 CSP 를 두는 의미가 거의 없다.
        키는 data 속성으로 넘긴다.
      */}
      <script>
        const el = document.getElementById('userlink');
        if (el) {
          let on = false;
          try {
            on = !!localStorage.getItem(el.dataset.authkey!);
          } catch {
            /* 저장소를 막아 둔 브라우저 — 로그인 안 한 것으로 본다 */
          }
          (el as HTMLAnchorElement).href = on ? '/me' : '/login';
          el.textContent = on ? '내 정보' : '로그인';
          el.hidden = false;
        }
      </script>

      <nav class="gnb" aria-label="주 메뉴">
        {
          navItems.map((item) => (
            <div class="gnb-item" data-key={item.key}>
              <a
                class:list={['gnb-link', { 'gnb-link--cta': 'cta' in item && item.cta }]}
                href={item.href}
                aria-current={item.active ? 'page' : undefined}
              >
                {item.label}
              </a>
            </div>
          ))
        }
      </nav>

      {
        activeWithChildren && (
          <nav class="subbar" aria-label={`${activeWithChildren.label} 하위 메뉴`}>
            {activeWithChildren.children!.map((c) => (
              <a href={c.href} aria-current={path === c.href ? 'page' : undefined}>
                {c.label}
              </a>
            ))}
          </nav>
        )
      }
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-foot">
      <div class="wrap">
        <div class="foot-top">
          <div>
            <p class="foot-brand">{SITE.name}</p>
            <p class="small muted foot-note">
              커리큘럼과 강의자료, 실습 데이터를 무료로 공개합니다.
            </p>
          </div>
          <nav class="foot-nav" aria-label="footer">
            <a href="/join">가입하기</a>
            <a href="/materials">자료실</a>
            <a href="/about">우리는 누구인가</a>
            <a href="/about/committee">교육위원회</a>
            <a href="/about/faq">자주 묻는 질문</a>
            <a href="/about/license">자료 이용 조건</a>
            <a href="/program">교육프로그램</a>
            <a href="/program/blocks">기능별 훈련</a>
            <a href="/program/workflows">워크플로우</a>
            <a href="/insights">블로그</a>
            <a href="/privacy">개인정보 처리방침</a>
            <a href={YOUTUBE.url} rel="noopener">유튜브 「{YOUTUBE.name}」</a>
          </nav>
        </div>

        <div class="foot-legal small">
          <p>
            <strong>{COMPANY.name}</strong> · 대표이사 {COMPANY.ceo} · 사업자등록번호{' '}
            <span class="num">{COMPANY.bizNo}</span>
          </p>
          <p>{COMPANY.address} · <a href={`mailto:${COMPANY.email}`}>{COMPANY.email}</a></p>
          <p class="muted">© {new Date().getFullYear()} {COMPANY.nameEn}</p>
        </div>
      </div>
    </footer>

    <style>
      /* 머리말은 세 층이다 — 워드마크 / 주 메뉴 / 하위 메뉴.
         하위 메뉴를 드롭다운으로 감추지 않고 두 번째 줄에 그대로 편다. */
      .site-head {
        position: sticky;
        top: 0;
        z-index: 20;
        background: var(--bg);
        border-bottom: 1px solid var(--line);
      }

      /* ── 1층 · 워드마크 ── */
      .brandbar {
        position: relative;
        display: grid;
        place-items: center;
        padding: 1.35rem 1.25rem 1.1rem;
      }
      .brand {
        font-family: var(--serif);
        font-size: clamp(1.4rem, 1rem + 1.6vw, 2.05rem);
        font-weight: 500;
        letter-spacing: 0.01em;
        text-indent: 0.01em; /* 자간 때문에 오른쪽이 비어 보이는 것 보정 */
        color: var(--ink);
        text-decoration: none;
        line-height: 1.2;
        white-space: nowrap;
      }
      /* 로그인 상태 — 워드마크 가운데 정렬을 건드리지 않게 띄워서 오른쪽 끝에 둔다 */
      .userlink {
        position: absolute;
        right: 1.25rem;
        top: 50%;
        transform: translateY(-50%);
        font-family: var(--sans);
        font-size: 0.8rem;
        color: var(--ink-3);
        text-decoration: none;
        white-space: nowrap;
      }
      .userlink:hover { color: var(--ink); }

      /* ── 2층 · 주 메뉴 — 폭 전체에 고르게 ── */
      .gnb {
        display: flex;
        justify-content: space-evenly;
        align-items: stretch;
        gap: 0.5rem;
        padding: 0 1.25rem;
      }
      .gnb-item { display: flex; }
      .gnb-link {
        font-family: var(--serif);
        font-size: clamp(0.95rem, 0.86rem + 0.35vw, 1.1rem);
        font-weight: 450;
        color: var(--ink-3);
        text-decoration: none;
        padding: 0.5rem 0.25rem 0.75rem;
        border-bottom: 2px solid transparent;
        white-space: nowrap;
        transition: color 0.12s, border-color 0.12s;
      }
      .gnb-link:hover { color: var(--ink); }
      .gnb-link[aria-current='page'] {
        color: var(--ink);
        font-weight: 600;
        border-bottom-color: var(--brand);
      }
      /* 유일한 행동 유도 — 버튼을 따로 두지 않고 메뉴 안에서 무게만 다르게 준다 */
      .gnb-link--cta { color: var(--accent); font-weight: 550; }
      .gnb-link--cta:hover { color: var(--accent); border-bottom-color: var(--accent); }

      /* ── 3층 · 하위 메뉴 — 지금 구역의 것이 늘 보인다 ── */
      .subbar {
        display: flex;
        justify-content: space-evenly;
        gap: 0.5rem 1.5rem;
        flex-wrap: wrap;
        padding: 0.62rem 1.25rem;
        background: var(--tint);
        border-top: 1px solid color-mix(in srgb, var(--brand) 12%, transparent);
      }
      .subbar a {
        font-family: var(--serif);
        font-size: 0.92rem;
        color: var(--ink-2);
        text-decoration: none;
        white-space: nowrap;
      }
      .subbar a:hover { color: var(--ink); }
      .subbar a[aria-current='page'] { color: var(--ink); font-weight: 500; }

      /* 모바일 — 오픈채팅·카카오 유입이 대부분 모바일이다.
         CTA 를 워드마크 아래로 내리고 메뉴는 줄바꿈시킨다. */
      @media (max-width: 40rem) {
        .brandbar { padding: 1.1rem 1rem 0.85rem; }
        .userlink { right: 1rem; font-size: 0.74rem; }
        .gnb { flex-wrap: wrap; justify-content: center; gap: 0.25rem 1.35rem; padding-inline: 1rem; }
        .subbar { justify-content: center; padding-inline: 1rem; }
      }

      .site-foot {
        border-top: 1px solid var(--line);
        background: var(--bg-soft);
        padding: 3.5rem 0 3rem;
        margin-top: 5rem;
        font-family: var(--sans);
      }
      .foot-top {
        display: flex;
        flex-wrap: wrap;
        gap: 1.75rem 3rem;
        justify-content: space-between;
        padding-bottom: 2rem;
        border-bottom: 1px solid var(--line);
      }
      .foot-brand {
        font-family: var(--serif);
        font-size: 1.12rem;
        font-weight: 500;
        letter-spacing: 0.01em;
        margin: 0 0 0.4rem;
      }
      .foot-note { margin: 0; max-width: 26rem; }
      .foot-nav { display: flex; flex-wrap: wrap; gap: 0.55rem 1.5rem; font-size: 0.9rem; align-content: start; }
      .foot-nav a { color: var(--ink-2); text-decoration: none; }
      .foot-nav a:hover { color: var(--ink); text-decoration: underline; }
      .foot-legal { padding-top: 1.75rem; color: var(--ink-2); line-height: 1.8; }
      .foot-legal p { margin: 0 0 0.2rem; }
    </style>
  </body>
</html>

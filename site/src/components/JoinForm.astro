---
/**
 * 가입 폼.
 *
 * 필수는 이메일 하나다. 이름과 소속은 선택으로 둔다.
 *
 * 전화번호는 여기서 받지 않는다. 지금 쓸 데가 없고, 받는 순간 문자 수신동의
 * (정보통신망법 §50)와 처리방침·국외이전 표에 항목이 붙는다. 무엇보다 자료를
 * 한 번 받으려고 들어온 분께 전화번호를 요구하면 거기서 사람을 잃는다 —
 * 확산이 목적인 프로그램에서 가장 아까운 손실이다.
 * 연락이 실제로 필요한 자리(오프라인 과정 신청)가 생기면 그 자리에서 받는다.
 *
 * 비밀번호를 두지 않는다. 메일로 오는 링크를 누르면 로그인되는 방식이라
 * 가입과 로그인이 한 번에 끝나고, 우리가 비밀번호를 보관할 일도 없다.
 */
const SEGMENTS = ['회계법인', '기업 재무팀', '세무사무소', '학계', '학생', '기타'];
---

<form class="join" id="join-form" novalidate>
  <div class="row">
    <label class="field field--email">
      <span class="lab">이메일 <em>필수</em></span>
      <input
        type="email"
        name="email"
        required
        autocomplete="email"
        placeholder="name@example.com"
      />
    </label>
    <label class="field">
      <span class="lab">이름 <em class="opt">선택</em></span>
      <input type="text" name="full_name" autocomplete="name" placeholder="홍길동" />
    </label>
    <label class="field">
      <span class="lab">소속 <em class="opt">선택</em></span>
      <select name="segment">
        <option value="">선택 안 함</option>
        {SEGMENTS.map((s) => <option value={s}>{s}</option>)}
      </select>
    </label>
  </div>
  <p class="small muted why">
    이름은 메일에서 어떻게 불러 드릴지에만 씁니다. 적지 않으셔도 모든 기능을 똑같이
    쓰실 수 있습니다. <strong>전화번호는 받지 않습니다.</strong>
  </p>

  <ul class="agree">
    <li>
      <label>
        <input type="checkbox" name="agree_required" required />
        <span>
          <strong>[필수]</strong> 아래 「수집하는 것과 쓰는 곳」에 동의하며, 뉴스레터가
          발송되는 것을 확인했습니다.
        </span>
      </label>
    </li>
    <li>
      <label>
        <input type="checkbox" name="marketing" />
        <span>
          <strong>[선택]</strong> 부트캠프 모집·커뮤니티 개설 등 그 밖의 안내도 받겠습니다.
        </span>
      </label>
    </li>
  </ul>

  <button class="btn" type="submit">가입하기</button>
  <p class="msg" role="status" aria-live="polite"></p>
  <p class="small muted have">
    이미 가입하셨습니까? <a href="/login">로그인</a>
  </p>
</form>

<script>
  import { supabase, callbackUrl, rememberNext, ko } from '../lib/supabase';

  const form = document.getElementById('join-form') as HTMLFormElement;
  const btn = form.querySelector('button')!;
  const msg = form.querySelector('.msg') as HTMLElement;

  const say = (text: string, kind: 'ok' | 'err' | '' = '') => {
    msg.textContent = text;
    msg.className = 'msg' + (kind ? ' msg--' + kind : '');
  };

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const f = new FormData(form);
    const email = String(f.get('email') ?? '').trim();

    if (!email || !email.includes('@')) return say('이메일 주소를 입력해 주십시오.', 'err');
    if (!f.get('agree_required')) return say('필수 항목에 동의해 주셔야 가입이 됩니다.', 'err');

    btn.disabled = true;
    say('메일을 보내고 있습니다…');

    rememberNext('/me');

    const { error } = await supabase.auth.signInWithOtp({
      email,
      options: {
        emailRedirectTo: callbackUrl(),
        // 계정을 만드는 자리다. 로그인 화면과 달리 신규 생성을 허용한다.
        shouldCreateUser: true,
        // 계정이 처음 만들어질 때만 반영된다 → 트리거가 profiles 로 옮겨 적는다.
        data: {
          full_name: String(f.get('full_name') ?? '').trim(),
          segment: String(f.get('segment') ?? ''),
          marketing_opt_in: !!f.get('marketing'),
        },
      },
    });

    btn.disabled = false;

    if (error) return say(ko(error.message), 'err');

    form.querySelector('.row')!.setAttribute('hidden', '');
    form.querySelector('.why')!.setAttribute('hidden', '');
    form.querySelector('.agree')!.setAttribute('hidden', '');
    btn.hidden = true;
    say(
      // 「주소로」를 붙인다. `${email} 으로` 는 조사를 띄어 쓴 데다,
      // 메일 주소가 모음으로 끝나면(…io) 「으로」 자체가 틀린 조사가 된다.
      `${email} 주소로 가입 링크를 보냈습니다. 메일함에서 링크를 누르시면 가입이 끝납니다. ` +
        '메일이 보이지 않으면 스팸함도 확인해 주십시오.',
      'ok'
    );
  });
</script>

<style>
  .join { margin: 0; }
  .row { display: flex; flex-wrap: wrap; gap: 0.7rem; align-items: end; }
  .field { display: flex; flex-direction: column; gap: 0.3rem; flex: 1 1 12rem; }
  .field--email { flex: 2 1 17rem; }
  .lab { font-family: var(--sans); font-size: 0.8rem; font-weight: 600; color: var(--ink-2); }
  .lab em { font-style: normal; font-weight: 600; color: var(--b-J); font-size: 0.74rem; margin-left: 0.2em; }
  .lab em.opt { color: var(--ink-3); }

  .why { margin: 0.85rem 0 0; }

  input[type='email'], input[type='text'], select {
    font: inherit;
    font-size: 0.95rem;
    padding: 0.58em 0.75em;
    border: 1px solid var(--line);
    border-radius: 3px;
    background: var(--bg);
    color: var(--ink);
    width: 100%;
  }
  input:focus, select:focus { border-color: var(--accent); }

  .agree { list-style: none; margin: 1.3rem 0; padding: 0; font-family: var(--sans); }
  .agree li { margin-bottom: 0.55rem; }
  .agree label { display: flex; gap: 0.6rem; align-items: start; font-size: 0.9rem; cursor: pointer; }
  .agree input { margin-top: 0.28em; flex: none; accent-color: var(--accent); }
  .agree strong { font-weight: 600; }

  .btn[disabled] { opacity: 0.55; pointer-events: none; }

  .msg:empty { display: none; }
  .msg {
    font-family: var(--sans);
    font-size: 0.9rem;
    line-height: 1.7;
    margin: 1rem 0 0;
    color: var(--ink-2);
  }
  .msg--err { color: var(--b-J); }
  .msg--ok {
    color: var(--ink);
    background: var(--tint-soft);
    border-left: 2px solid var(--brand);
    padding: 0.85rem 1.1rem;
  }

  .have { margin: 1rem 0 0; }
</style>

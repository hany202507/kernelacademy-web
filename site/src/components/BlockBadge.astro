---
// 배지에는 항상 문자(R·C·P…)를 함께 넣는다.
// 색만으로 정보를 전달하지 않는 것 — 색각 이상 대응이자 흑백 인쇄 대응이다.
// 강의안이 인쇄돼 돌아다니는 자료라 실제로 중요하다. (14번 §4-3)
interface Props {
  id: string;
  label?: string;
  size?: 'sm' | 'md' | 'lg';
}
const { id, label, size = 'md' } = Astro.props;
---

<span class:list={['badge', `badge--${size}`]} style={`--c: var(--b-${id})`}>
  <span class="badge-mark" aria-hidden="true">{id}</span>
  {label && <span class="badge-label">{label}</span>}
  {/* 라벨이 보이면 그것으로 충분하다. 없을 때만 문자를 풀어 읽어 준다. */}
  <span class="sr-only">{label ? '블록' : `${id} 블록`}</span>
</span>

<style>
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 0.42em;
    font-weight: 600;
    line-height: 1;
    color: var(--c);
  }
  .badge-mark {
    display: grid;
    place-items: center;
    background: color-mix(in srgb, var(--c) 10%, var(--bg));
    border: 1px solid color-mix(in srgb, var(--c) 32%, var(--bg));
    border-radius: 5px;
    font-variant-numeric: tabular-nums;
  }
  .badge-label { color: var(--ink); }

  .badge--sm { font-size: 0.8rem; }
  .badge--sm .badge-mark { width: 1.35rem; height: 1.35rem; font-size: 0.72rem; }

  .badge--md { font-size: 0.94rem; }
  .badge--md .badge-mark { width: 1.65rem; height: 1.65rem; font-size: 0.85rem; }

  .badge--lg { font-size: 1.1rem; }
  .badge--lg .badge-mark { width: 2.15rem; height: 2.15rem; font-size: 1.05rem; border-radius: 3px; }
</style>

---
/**
 * 글 카드·머리말의 사진.
 *
 * 흑백으로 깔고 세이지를 곱해 얹는다(듀오톤). 출처가 제각각인 스톡 사진을
 * 그대로 쓰면 색이 따로 놀아 지면이 흩어지기 때문이다.
 * 사진이 없는 글은 빈 지면으로 두고 레이아웃은 유지한다.
 */
interface Props {
  src?: string;
  alt?: string;
  /** 카드 위에 얹는 짧은 라벨 */
  badge?: string;
  /** 글 머리말용 — 더 넓고 낮게 */
  wide?: boolean;
  /** 첫 화면에 보이는 사진은 지연 로딩하지 않는다 */
  eager?: boolean;
}
const { src, alt = '', badge, wide = false, eager = false } = Astro.props;
---

<div class:list={['cover', { 'cover--wide': wide }]}>
  {
    src && (
      <img
        src={src}
        alt={alt}
        width={wide ? 1200 : 640}
        height={wide ? 500 : 400}
        loading={eager ? 'eager' : 'lazy'}
        decoding="async"
      />
    )
  }
  {badge && <span class="badge">{badge}</span>}
</div>

<style>
  .cover {
    position: relative;
    aspect-ratio: 16 / 10;
    background: var(--tint-soft);
    border: 1px solid var(--line);
    border-radius: 3px;
    overflow: hidden;
    transition: border-color 0.14s;
  }
  .cover--wide { aspect-ratio: 12 / 5; }

  img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    /* 흑백으로 낮춘 뒤 아래 세이지 층과 곱해져 듀오톤이 된다 */
    filter: grayscale(1) contrast(1.04) brightness(1.03);
  }

  /* 세이지 층 — 세 장이 한 세트로 보이게 하는 장치 */
  .cover::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--brand);
    opacity: 0.17;
    mix-blend-mode: multiply;
    pointer-events: none;
  }

  .badge {
    position: absolute;
    left: 0.75rem;
    bottom: 0.75rem;
    z-index: 1;
    font-family: var(--sans);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--ink);
    background: color-mix(in srgb, var(--bg) 92%, transparent);
    backdrop-filter: blur(6px);
    border-radius: 2px;
    padding: 0.3em 0.65em;
  }
  .cover--wide .badge { left: 1.1rem; bottom: 1.1rem; font-size: 0.78rem; }

  @media (prefers-reduced-motion: reduce) { .cover { transition: none; } }
</style>

---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import BlockBadge from '../../components/BlockBadge.astro';
import Matrix from '../../components/Matrix.astro';
import { workflowSteps } from '../../lib/canon';
import { SITE } from '../../data/site';

const workflows = (await getCollection('workflows')).sort((a, b) => a.data.order - b.data.order);

const cards = workflows.map((w) => ({
  ...w.data,
  steps: workflowSteps(w.body ?? ''),
}));

const schema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: `${SITE.curriculum} 업무 워크플로 7종`,
  itemListElement: cards.map((w, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: w.title,
    description: `대표 시나리오 ${w.scenario} · 조합 ${w.combo.join('→')}`,
  })),
};
---

<Base
  title="워크플로우"
  description="세무·회계결산·자금·감사대응·내부통제·보고·예산관리. 업무 단위로 기능을 조립하는 일곱 워크플로와 전체 지도."
  schema={schema}
>
  <section class="section section--tint pagehead">
    <div class="prose">
      <p class="eyebrow">워크플로우</p>
      <h1>내 업무에서는 이렇게 조립합니다</h1>
      <p class="lede">
        <span class="s">실무자는 부가세 매입세액 불공제, 결산 대사처럼 업무 이름으로 일을 기억합니다.</span>
        <span class="s">리서치나 검증 같은 기능 이름으로 기억하지 않습니다.</span>
        <span class="s">그래서 기능별 정리와 함께 업무별 정리를 하나 더 두었습니다.</span>
      </p>
    </div>
  </section>

  <!-- ① 7워크플로 -->
  <section class="section">
    <div class="prose-wide">
      <h2 class="lead-h">업무 일곱 갈래</h2>
      <p class="lede">
        <span class="s">펼치시면 어느 기능이 어떤 순서로 들어가는지 보실 수 있습니다.</span>
        <span class="s">같은 기능이라도 업무에 따라 하는 일이 달라집니다.</span>
      </p>
    </div>

    <div class="wrap">
      <div class="flows">
        {
          cards.map((w) => (
            <details class="flow">
              <summary>
                <span class="flow-name">{w.title}</span>
                <span class="flow-scn small muted">{w.scenario}</span>
                <span class="combo" aria-label={`사용 기능 ${w.combo.join(', ')}`}>
                  {w.combo.map((c) => (
                    <BlockBadge id={c} size="sm" />
                  ))}
                </span>
              </summary>
              <div class="flow-body">
                <ol class="steps">
                  {w.steps.map((s) => (
                    <li>
                      <BlockBadge id={s.block} size="sm" />
                      <span class="small">{s.task}</span>
                    </li>
                  ))}
                </ol>
              </div>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ② 전체 지도 -->
  <section class="section section--soft">
    <div class="wrap">
      <h2 class="lead-h">전체 지도</h2>
      <p class="lede narrow">
        <span class="s">가로가 기능, 세로가 업무입니다.</span>
        <span class="s">
          표의 칸 하나가 교재 한 단위이고,
          <strong>아직 열지 않은 것은 그대로 표시했습니다.</strong>
        </span>
      </p>
      <div class="matrix-wrap">
        <Matrix />
      </div>

      <p class="closing narrow">
        검토를 마친 부분부터 차례로 엽니다. 검토를 받기로 해 놓고 먼저 내보내면
        그 절차가 형식에 그칩니다.
        → <a href="/about/committee">교육위원회</a>
      </p>
    </div>
  </section>
</Base>

<style>
  .pagehead { padding-bottom: clamp(2.25rem, 4vw, 3.25rem); }
  .pagehead .lede { margin-bottom: 0; }
  .lead-h { margin-top: 0; }
  .narrow { max-width: 42rem; }

  .flows { display: grid; gap: 0.55rem; margin-top: 2rem; }
  .flow { border: 1px solid var(--line); border-radius: 3px; background: var(--bg); }
  .flow summary {
    cursor: pointer;
    padding: 0.95rem 1.15rem;
    display: flex;
    align-items: center;
    gap: 0.5rem 0.9rem;
    flex-wrap: wrap;
    list-style: none;
  }
  .flow summary::-webkit-details-marker { display: none; }
  .flow summary::after {
    content: '＋';
    margin-left: auto;
    color: var(--ink-3);
    font-size: 0.9rem;
    order: 9;
  }
  .flow[open] summary::after { content: '－'; }
  .flow-name { font-weight: 600; }
  .flow-scn { flex: 1 1 12rem; }
  .combo { display: flex; gap: 0.25rem; flex-wrap: wrap; }

  .flow-body { padding: 0.9rem 1.15rem 1.15rem; border-top: 1px solid var(--line); }
  .steps { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.55rem; }
  .steps li { display: flex; gap: 0.7rem; align-items: baseline; margin: 0; }
  .steps li > span { color: var(--ink-2); line-height: 1.65; }

  .matrix-wrap { margin-top: 2rem; }
  .closing { margin-top: 2.5rem; }
</style>

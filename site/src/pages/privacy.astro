---
import Base from '../layouts/Base.astro';
import { COMPANY, SITE } from '../data/site';

/**
 * 개인정보 처리방침.
 *
 * 개인정보 보호법 §30 의 필수 기재사항을 순서대로 담는다.
 * 로그인·자료실·사용 등록이 붙으면서 세 가지가 바뀌었다 —
 *   ① 국외 이전이 실제로 생겼다(Supabase·Resend·GitHub 모두 미국 법인)
 *   ② 사용 등록 신청의 담당자 연락처로 성명을 받는다("이름 안 받음"이 더는 사실이 아니다)
 *   ③ 접속기록이 남는다
 * 셋 다 감추지 않고 표로 적는다. 감추면 §28-8 위반이고, 적으면 그냥 사실이다.
 *
 * ⚠️ 「인증」은 자격기본법 §39 금칙어라 빌드가 막힌다(scripts/lint-forbidden.mjs).
 *    로그인·본인 확인으로 쓴다.
 */
const 시행일 = '2026-08-09';
const 이전일 = '2026-08-07';

/** 국외 이전 — §28-8 ③ 이 요구하는 다섯 가지를 한 행에 다 담는다. */
const 국외 = [
  {
    자: 'Supabase, Inc.',
    국가: '미국',
    주: '데이터베이스는 AWS 서울 리전에 둡니다. 다만 운영 주체가 국외 법인이므로 국외 이전으로 봅니다.',
    항목: '이메일, 소속 유형, 수신 동의 여부, 접속기록, 자료 사용 등록 신청 내용',
    목적: '로그인 처리 · 회원 정보와 신청 내역 보관 · 파일 보관',
    시점: '가입·로그인·신청 시점에 정보통신망을 통해 전송',
    보유: '가입 해지 시까지',
    연락처: 'support@supabase.io',
  },
  {
    자: 'Resend',
    국가: '미국',
    항목: '이메일 주소, 발송하는 메일의 내용',
    목적: '로그인 링크 · 자료 공개 알림 · 뉴스레터 발송',
    시점: '메일 발송 시점에 정보통신망을 통해 전송',
    보유: '발송 후 30일(발송 이력)',
    연락처: 'support@resend.com',
  },
  {
    자: 'GitHub, Inc.',
    국가: '미국',
    항목: '접속 IP 주소, 브라우저 정보',
    목적: '웹사이트 호스팅',
    시점: '웹사이트 접속 시 자동 전송',
    보유: 'GitHub의 정책에 따릅니다',
    연락처: 'privacy@github.com',
  },
];

const 구제 = [
  { 기관: '개인정보분쟁조정위원회', 전화: '1833-6972', url: 'https://www.kopico.go.kr' },
  { 기관: '개인정보침해신고센터', 전화: '118', url: 'https://privacy.kisa.or.kr' },
  { 기관: '대검찰청 사이버수사과', 전화: '1301', url: 'https://www.spo.go.kr' },
  { 기관: '경찰청 사이버수사국', 전화: '182', url: 'https://ecrm.police.go.kr' },
];
---

<Base
  title="개인정보 처리방침"
  description="Kernel Academy가 수집하는 개인정보 항목과 처리 목적, 보유 기간, 국외 이전 내역."
>
  <section class="section section--tint pagehead">
    <div class="prose">
      <p class="eyebrow">개인정보 처리방침</p>
      <h1>읽는 데에는 아무것도 받지 않습니다</h1>
      <p class="lede">
        <span class="s">
          {COMPANY.name}(이하 "회사")는 {SITE.name} 웹사이트를 운영하며 아래와 같이 개인정보를 처리합니다.
        </span>
        <span class="s"><strong>커리큘럼과 글을 읽으시는 데에는 어떤 정보도 요구하지 않습니다.</strong></span>
        <span class="s">가입은 파일을 내려받으실 때와 자료 사용 등록을 하실 때만 필요합니다.</span>
      </p>
      <p class="small muted num shipdate">시행일 {시행일}</p>
    </div>
  </section>

  <article class="section">
    <div class="prose">
      <h2 class="first">1. 무엇을 언제 받는가</h2>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th scope="col">언제</th>
              <th scope="col">항목</th>
              <th scope="col">목적</th>
              <th scope="col">보유 기간</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <th scope="row">웹에서 읽기</th>
              <td class="none">받지 않음</td>
              <td class="small">—</td>
              <td class="small">—</td>
            </tr>
            <tr>
              <th scope="row">가입</th>
              <td class="small">
                <strong>이메일</strong> <span class="req">필수</span><br />
                이름 <span class="opt">선택</span><br />
                소속 유형 <span class="opt">선택</span><br />
                수신 동의 여부
                <span class="hint">전화번호는 받지 않습니다</span>
              </td>
              <td class="small">
                로그인 · 파일 내려받기 제공 · 자료 공개 알림 · 교육 일정 안내 · 뉴스레터 발송
              </td>
              <td class="small">가입 해지 시까지</td>
            </tr>
            <tr>
              <th scope="row">로그인·이용 중<br />(자동 수집)</th>
              <td class="small">접속 일시, IP 주소, 브라우저 정보</td>
              <td class="small">부정 이용 방지 · 장애 대응</td>
              <td class="small">최대 90일</td>
            </tr>
            <tr>
              <th scope="row">자료 사용 등록 신청</th>
              <td class="small">
                기관명, 과정명, 사용 기간, 이용 유형<br />
                <strong>담당자 연락처</strong> <span class="req">필수</span>
                <span class="hint">성명과 이메일 또는 전화번호를 적어 주시게 됩니다</span><br />
                담당자 성명·사진·후기 공개 동의 <span class="opt">선택</span>
              </td>
              <td class="small">등록 처리 · 등록번호 발급 · 회신</td>
              <td class="small">사용 기간 종료 후 3년<br /><span class="hint">이용을 허락한 사실의 증빙</span></td>
            </tr>
            <tr>
              <th scope="row">문의</th>
              <td class="small">이메일, 문의 내용</td>
              <td class="small">문의 응대</td>
              <td class="small">응대 완료 후 1년</td>
            </tr>
          </tbody>
        </table>
      </div>

      <p>
        <strong>가입에 필수인 것은 이메일 하나입니다.</strong> 이름은 메일에서 어떻게
        불러 드릴지에만 쓰고, 소속 유형은 콘텐츠 구성을 위한 통계에 씁니다. 둘 다
        선택이므로 적지 않으셔도 모든 서비스를 똑같이 이용하실 수 있습니다.
      </p>
      <p>
        <strong>가입 단계에서 전화번호를 받지 않습니다.</strong> 지금 쓸 데가 없기
        때문입니다. 오프라인 과정 신청처럼 연락이 실제로 필요한 때가 오면 그때
        목적을 밝히고 따로 받겠습니다.
      </p>
      <p>
        다만 <strong>자료 사용 등록을 신청하실 때는 담당자 연락처를 필수로 받습니다.</strong>
        등록번호를 발급하고 회신할 곳이 필요하기 때문입니다. 이때 적으시는 성명은 개인정보에
        해당합니다. 담당자의 성명과 사진, 후기를 <strong>소개 자료에 쓰는 것은 별도의 선택
        동의</strong> 사항이며, 동의하지 않으셔도 등록에는 영향이 없습니다.
      </p>

      <h2>2. 비밀번호를 두지 않습니다</h2>
      <p>
        로그인은 메일로 보내 드리는 링크로 이루어집니다.
        <strong>회사는 비밀번호를 만들지도, 받지도, 보관하지도 않습니다.</strong>
      </p>

      <h2>3. 처리 위탁</h2>
      <div class="table-wrap">
        <table>
          <thead>
            <tr><th scope="col">수탁자</th><th scope="col">위탁하는 업무</th></tr>
          </thead>
          <tbody>
            <tr>
              <th scope="row">Supabase, Inc.</th>
              <td class="small">회원 정보·신청 내역 보관, 로그인 처리, 자료 파일 보관</td>
            </tr>
            <tr>
              <th scope="row">Resend</th>
              <td class="small">로그인 링크 및 안내·뉴스레터 메일 발송</td>
            </tr>
            <tr>
              <th scope="row">GitHub, Inc.</th>
              <td class="small">웹사이트 호스팅</td>
            </tr>
          </tbody>
        </table>
      </div>
      <p class="small muted">
        수탁자가 바뀌면 이 페이지에 시행일과 함께 알려 드립니다.
      </p>

      <h2 id="overseas">4. 국외 이전</h2>
      <p>
        위 수탁자는 모두 국외에 본사를 둔 사업자입니다. 따라서
        <strong>개인정보가 국외로 이전됩니다.</strong> 이전되는 내용은 아래와 같습니다.
      </p>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th scope="col">이전받는 자</th>
              <th scope="col">국가</th>
              <th scope="col">이전 항목</th>
              <th scope="col">이전 일시·방법</th>
              <th scope="col">이용 목적</th>
              <th scope="col">보유 기간</th>
            </tr>
          </thead>
          <tbody>
            {
              국외.map((r) => (
                <tr>
                  <th scope="row">
                    {r.자}
                    <span class="hint">{r.연락처}</span>
                  </th>
                  <td class="small">
                    {r.국가}
                    {r.주 && <span class="hint">{r.주}</span>}
                  </td>
                  <td class="small">{r.항목}</td>
                  <td class="small">{r.시점}</td>
                  <td class="small">{r.목적}</td>
                  <td class="small">{r.보유}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <h3>이전을 거부하실 수 있습니다</h3>
      <p>
        <strong>가입하지 않으시면 이전이 일어나지 않습니다.</strong> 이 경우 파일 내려받기와
        자료 사용 등록을 이용하실 수 없지만, <strong>웹에서 읽으시는 데에는 아무 제약이
        없습니다.</strong> 가입한 뒤에 거부하고자 하시면 아래 연락처로 해지를 요청해 주십시오.
        지체 없이 파기하고 회신드립니다.
      </p>
      <p class="small muted">
        다만 웹사이트 호스팅(GitHub)은 접속하시는 것만으로 IP 주소가 전달되므로, 이 부분은
        접속하지 않으시는 것 외에 거부할 방법이 없습니다.
      </p>

      <h2>5. 제3자 제공</h2>
      <p>
        제3자에게 제공하지 않습니다. 법령에 따른 요구가 있는 경우에만 예외로 하며,
        그 경우에도 요구된 범위를 넘어 제공하지 않습니다.
      </p>

      <h2>6. 자동으로 수집되는 것</h2>
      <p>
        <strong>방문자 분석 도구를 쓰지 않습니다.</strong> 광고를 붙이지 않고, 행태정보를
        수집하지 않으며, 제3자 추적 스크립트를 넣지 않습니다.
      </p>
      <p>
        로그인하시면 브라우저의 저장 공간(localStorage)에 로그인 상태를 유지하기 위한 토큰이
        저장됩니다. 이는 광고나 분석 목적이 아니며, <strong>로그아웃하시거나 브라우저의
        사이트 데이터를 지우시면 함께 삭제됩니다.</strong>
      </p>
      <p>
        서비스 이용 중에는 접속 일시·IP 주소·브라우저 정보가 자동으로 기록됩니다.
        부정 이용을 막고 장애에 대응하기 위한 것이며 최대 90일간 보관합니다.
      </p>

      <h2>7. 파기</h2>
      <p>
        보유 기간이 지나거나 처리 목적이 이루어지면 <strong>지체 없이 파기합니다.</strong>
        전자적 파일은 복구할 수 없는 방법으로 삭제합니다. 다른 법령에 따라 보존해야 하는
        경우에는 해당 기간 동안 분리하여 보관한 뒤 파기합니다.
      </p>

      <h2>8. 안전하게 지키기 위해 하는 일</h2>
      <ul class="safe">
        <li>
          <strong>최소 수집.</strong> 지금 쓸 데가 없는 항목은 받지 않습니다
        </li>
        <li>
          <strong>비밀번호 미보관.</strong> 메일 링크로 로그인하므로 비밀번호 자체가 없습니다
        </li>
        <li>
          <strong>접근 권한 제한.</strong> 데이터베이스에 행 단위 접근 정책을 걸어,
          로그인하신 분이 <strong>본인의 정보만</strong> 읽을 수 있게 합니다
        </li>
        <li>
          <strong>전송 구간 암호화.</strong> 웹사이트 전 구간에 HTTPS를 적용합니다
        </li>
        <li>
          <strong>파일 비공개 보관.</strong> 자료 파일은 주소를 알아도 열리지 않으며,
          로그인하신 분께 짧은 유효 시간을 둔 주소를 그때그때 발급합니다
        </li>
      </ul>

      <h2>9. 정보주체의 권리와 행사 방법</h2>
      <p>
        언제든지 <strong>열람·정정·삭제·처리정지</strong>를 요구하실 수 있습니다.
      </p>
      <ul class="rights">
        <li>
          <strong>직접 하실 수 있는 것.</strong> 소속 유형과 선택 수신 동의는
          <a href="/me">내 정보</a>에서 바로 고치실 수 있습니다. 뉴스레터 수신 거부는
          모든 메일 하단의 링크로 즉시 처리됩니다
        </li>
        <li>
          <strong>요청해 주셔야 하는 것.</strong> 가입 해지(계정·이메일 삭제)와 그 밖의
          요구는 아래 연락처로 알려 주시면 지체 없이 처리하고 결과를 회신드립니다
        </li>
      </ul>
      <p class="small muted">
        법정대리인이나 위임받은 분을 통해서도 하실 수 있습니다. 회사는 정당한 사유 없이
        요구를 지연하거나 거절하지 않습니다.
      </p>

      <h2>10. 만 14세 미만 아동</h2>
      <p>
        이 서비스는 재무·회계 실무자와 대학생 이상을 대상으로 합니다.
        <strong>만 14세 미만 아동의 개인정보를 수집하지 않습니다.</strong>
        수집된 사실이 확인되면 지체 없이 파기합니다.
      </p>

      <h2>11. 개인정보 보호책임자</h2>
      <div class="table-wrap">
        <table>
          <tbody>
            <tr><th scope="row">보호책임자</th><td>{COMPANY.ceo} (대표이사)</td></tr>
            <tr><th scope="row">연락처</th><td><a href={`mailto:${COMPANY.email}`}>{COMPANY.email}</a></td></tr>
            <tr><th scope="row">처리자</th><td>{COMPANY.name}</td></tr>
            <tr><th scope="row">사업자등록번호</th><td class="num">{COMPANY.bizNo}</td></tr>
            <tr><th scope="row">주소</th><td>{COMPANY.address}</td></tr>
          </tbody>
        </table>
      </div>
      <p class="small muted">
        개인정보 처리에 관한 문의·불만·피해 구제는 위 연락처로 주시면 됩니다.
      </p>

      <h2>12. 권익침해 구제 방법</h2>
      <p>
        회사의 처리에 만족하지 못하셨다면 아래 기관에 분쟁 해결이나 상담을 신청하실 수 있습니다.
      </p>
      <div class="table-wrap">
        <table>
          <thead>
            <tr><th scope="col">기관</th><th scope="col">전화</th><th scope="col">누리집</th></tr>
          </thead>
          <tbody>
            {
              구제.map((r) => (
                <tr>
                  <th scope="row">{r.기관}</th>
                  <td class="num">{r.전화}</td>
                  <td class="small">
                    <a href={r.url} rel="noopener">{r.url.replace('https://', '')}</a>
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <h2>13. 변경</h2>
      <p>
        내용이 바뀌면 <strong>시행일과 함께 이 페이지에 알려 드립니다.</strong>
        이용자에게 불리한 변경은 시행일 30일 전부터 알려 드립니다.
      </p>
      <ul class="hist">
        <li><span class="num">{시행일}</span> — 현행. 로그인·자료실·사용 등록 도입에 따라 국외 이전·자동 수집·보호책임자 항목을 추가</li>
        <li><span class="num">{이전일}</span> — 최초 시행</li>

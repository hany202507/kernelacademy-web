---
import Base from '../layouts/Base.astro';
import { COMPANY } from '../data/site';

const SEGMENTS = ['회계법인', '기업 재무팀', '세무사무소', '학계', '학생', '기타'];
---

<Base
  title="내 정보"
  description="가입 정보와 자료 사용 등록 내역을 확인하고 수정하실 수 있습니다."
  noindex
>
  <section class="section section--tint pagehead">
    <div class="prose">
      <p class="eyebrow">내 정보</p>
      <h1 id="hello">불러오고 있습니다…</h1>
      <p class="lede" id="since"></p>
    </div>
  </section>

  <section class="section">
    <div class="prose" id="body" hidden>
      <h2 class="first">가입 정보</h2>
      <form id="prefs">
        <label class="field">
          <span class="lab">이름 <em>선택</em></span>
          <input type="text" name="full_name" autocomplete="name" placeholder="홍길동" />
        </label>
        <label class="field">
          <span class="lab">소속 유형 <em>선택</em></span>
          <select name="segment">
            <option value="">선택 안 함</option>
            {SEGMENTS.map((s) => <option value={s}>{s}</option>)}
          </select>
        </label>
        <label class="check">
          <input type="checkbox" name="marketing" />
          <span>부트캠프 모집·커뮤니티 개설 등 그 밖의 안내도 받겠습니다</span>
        </label>
        <div class="actions">
          <button class="btn" type="submit">저장</button>
          <span class="msg" role="status" aria-live="polite"></span>
        </div>
      </form>
      <p class="small muted">
        뉴스레터는 가입 시 필수 동의 항목입니다. 수신을 멈추시려면 메일 하단의 수신 거부
        링크를 쓰시거나, 아래에서 가입을 해지해 주십시오.
      </p>

      <h2>자료</h2>
      <p>
        강의자료·실습 데이터는 <a href="/materials">자료실</a>에서 내려받으실 수 있습니다.
      </p>

      <h2>자료 사용 등록</h2>
      <div id="licenses">
        <p class="small muted">불러오는 중…</p>
      </div>
      <p class="small muted">
        타인을 가르치는 데 쓰시려면 <a href="/about/license">사용 등록</a>이 필요합니다.
      </p>

      <div class="danger">
        <h2>로그아웃 · 가입 해지</h2>
        <p>
          <button class="btn btn--quiet" type="button" id="signout">로그아웃</button>
        </p>
        <p class="small muted">
          가입 해지(계정·이메일 삭제)를 원하시면
          <a href={`mailto:${COMPANY.email}?subject=${encodeURIComponent('가입 해지 요청')}`}>
            {COMPANY.email}
          </a>
          로 알려 주십시오. 확인 후 지체 없이 파기하고 회신드립니다. 자세한 내용은
          <a href="/privacy">개인정보 처리방침</a>을 보십시오.
        </p>
      </div>
    </div>
  </section>
</Base>

<script>
  import { supabase, requireUser } from '../lib/supabase';

  const hello = document.getElementById('hello')!;
  const since = document.getElementById('since')!;
  const body = document.getElementById('body')!;
  const form = document.getElementById('prefs') as HTMLFormElement;
  const msg = form.querySelector('.msg') as HTMLElement;
  const box = document.getElementById('licenses')!;

  const day = (iso: string) => new Date(iso).toISOString().slice(0, 10);

  const STATUS: Record<string, string> = {
    pending: '접수됨',
    approved: '등록 완료',
    rejected: '반려',
  };

  (async () => {
    const user = await requireUser();
    if (!user) return;

    hello.textContent = user.email ?? '내 정보';
    since.textContent = user.created_at ? `가입일 ${day(user.created_at)}` : '';
    body.hidden = false;

    const { data: profile } = await supabase
      .from('profiles')
      .select('full_name, segment, marketing_opt_in')
      .eq('id', user.id)
      .maybeSingle();

    if (profile) {
      (form.elements.namedItem('full_name') as HTMLInputElement).value = profile.full_name ?? '';
      (form.elements.namedItem('segment') as HTMLSelectElement).value = profile.segment ?? '';
      (form.elements.namedItem('marketing') as HTMLInputElement).checked =
        !!profile.marketing_opt_in;
    }

    const { data: reqs, error } = await supabase
      .from('license_requests')
      .select('org_name, course_name, period, status, registration_no, created_at')
      .order('created_at', { ascending: false });

    box.innerHTML = '';
    if (error) {
      box.innerHTML = '<p class="small muted">내역을 불러오지 못했습니다.</p>';
    } else if (!reqs?.length) {
      box.innerHTML = '<p class="small muted">신청하신 내역이 없습니다.</p>';
    } else {
      const ul = document.createElement('ul');
      ul.className = 'reqs';
      for (const r of reqs) {
        const li = document.createElement('li');
        const head = document.createElement('p');
        head.className = 'req-head';
        head.textContent = `${r.org_name} — ${r.course_name}`;
        const meta = document.createElement('p');
        meta.className = 'req-meta small';
        meta.textContent =
          `${r.period} · 신청 ${day(r.created_at)} · ${STATUS[r.status] ?? r.status}` +
          (r.registration_no ? ` · 등록번호 ${r.registration_no}` : '');
        li.append(head, meta);
        ul.append(li);
      }
      box.append(ul);
    }
  })();

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const { data } = await supabase.auth.getSession();
    if (!data.session) return;

    const f = new FormData(form);
    msg.textContent = '저장 중…';

    const { error } = await supabase
      .from('profiles')
      .update({
        full_name: String(f.get('full_name') ?? '').trim() || null,
        segment: String(f.get('segment') ?? '') || null,
        marketing_opt_in: !!f.get('marketing'),
      })
      .eq('id', data.session.user.id);

    msg.textContent = error ? '저장하지 못했습니다.' : '저장했습니다.';
    if (!error) setTimeout(() => (msg.textContent = ''), 2500);
  });

  document.getElementById('signout')!.addEventListener('click', async () => {
    await supabase.auth.signOut();
    location.href = '/';
  });
</script>

<style>
  .pagehead { padding-bottom: clamp(2.25rem, 4vw, 3.25rem); }
  .pagehead .lede { margin-bottom: 0; font-family: var(--sans); font-size: 0.9rem; }
  .pagehead h1 { overflow-wrap: anywhere; }
  .first { margin-top: 0; }

  #prefs {
    padding: 1.5rem 1.65rem;
    border: 1px solid var(--line);
    border-radius: 3px;
    background: var(--bg-soft);
    max-width: 30rem;
  }
  .field { display: flex; flex-direction: column; gap: 0.3rem; margin-bottom: 1rem; }
  .lab { font-family: var(--sans); font-size: 0.8rem; font-weight: 600; color: var(--ink-2); }
  .lab em { font-style: normal; color: var(--ink-3); font-size: 0.74rem; margin-left: 0.2em; }
  select, input[type='text'] {
    font: inherit;
    font-size: 0.95rem;
    padding: 0.58em 0.75em;
    border: 1px solid var(--line);
    border-radius: 3px;
    background: var(--bg);
    color: var(--ink);
    width: 100%;
  }
  .check {
    display: flex;
    gap: 0.6rem;
    align-items: start;
    font-family: var(--sans);
    font-size: 0.9rem;
    cursor: pointer;
    margin-bottom: 1.2rem;
  }
  .check input { margin-top: 0.28em; flex: none; accent-color: var(--accent); }
  .actions { display: flex; align-items: center; gap: 1rem; flex-wrap: wrap; }
  .msg { font-family: var(--sans); font-size: 0.85rem; color: var(--ink-2); }

  .reqs { list-style: none; margin: 1rem 0 0.5rem; padding: 0; }
  .reqs li {
    padding: 0.9rem 1.1rem;
    border: 1px solid var(--line);
    border-left: 2px solid var(--brand);
    border-radius: 3px;
    margin-bottom: 0.6rem;
  }
  .req-head { margin: 0 0 0.25rem; font-weight: 600; }
  .req-meta { margin: 0; color: var(--ink-2); font-family: var(--sans); }

  .danger { margin-top: 3.5rem; padding-top: 1.5rem; border-top: 1px solid var(--line); }
  .btn--quiet {
    background: transparent;
    color: var(--ink-2);
    border: 1px solid var(--line);
  }
  .btn--quiet:hover { color: var(--ink); border-color: var(--ink-3); }
</style>

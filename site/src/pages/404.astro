---
import Base from '../layouts/Base.astro';
import { CATEGORIES } from '../data/site';

/**
 * 없는 주소로 들어왔을 때.
 *
 * GitHub Pages 는 dist/404.html 을 자동으로 이 자리에 쓴다. 따로 설정할 것이 없다.
 *
 * 여기까지 오시는 경로는 대개 셋이다 — 오래된 링크, 오타, 그리고 아직 열리지 않은
 * 커리큘럼 주소. 그래서 "없습니다" 로 끝내지 않고 갈 곳을 함께 둔다.
 */
const 분류 = Object.values(CATEGORIES);
---

<Base
  title="찾으시는 페이지가 없습니다"
  description="주소가 바뀌었거나 아직 열지 않은 페이지일 수 있습니다."
  noindex
>
  <section class="section section--tint pagehead">
    <div class="prose">
      <p class="eyebrow num">404</p>
      <h1>찾으시는 페이지가 없습니다</h1>
      <p class="lede">
        <span class="s">주소가 바뀌었거나 <strong>아직 열지 않은 페이지</strong>일 수 있습니다.</span>
        <span class="s">리터러시 2시간은 자료실에서 바로 받으실 수 있습니다. 실무 12시간은 2026년 9월, 심화 24시간은 10월에 엽니다.</span>
      </p>
    </div>
  </section>

  <section class="section">
    <div class="prose">
      <h2 class="first">여기서 시작해 보십시오</h2>
      <ul class="ways">
        <li>
          <a href="/program">교육프로그램</a>
          <span>일을 여섯 기능으로 쪼개고 일곱 업무로 다시 묶는 구조</span>
        </li>
        <li>
          <a href="/insights">블로그</a>
          <span>{분류.map((c) => c.label).join(' · ')}</span>
        </li>
        <li>
          <a href="/about">우리는 누구인가</a>
          <span>왜 전부 무료로 공개하는가</span>
        </li>
        <li>
          <a href="/about/faq">자주 묻는 질문</a>
          <span>무료 범위 · 수강 대상 · 자료 사용</span>
        </li>
      </ul>

      <p class="small muted">
        링크를 따라오셨는데 이 화면이 나왔다면 알려 주십시오. 어느 주소에서 오셨는지
        함께 적어 주시면 고치겠습니다.
        <a href="mailto:hello@kernelspace.io?subject=%EA%B9%A8%EC%A7%84%20%EB%A7%81%ED%81%AC%20%EC%A0%9C%EB%B3%B4">
          hello@kernelspace.io
        </a>
      </p>
    </div>
  </section>
</Base>

<style>
  .pagehead { padding-bottom: clamp(2.25rem, 4vw, 3.25rem); }
  .pagehead .lede { margin-bottom: 0; }
  .eyebrow { letter-spacing: 0.2em; }
  .first { margin-top: 0; }

  .ways { list-style: none; margin: 1.4rem 0 2.5rem; padding: 0; }
  .ways li {
    padding: 0.95rem 0;
    border-bottom: 1px solid var(--line);
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.35rem 1rem;
  }
  .ways a {
    font-family: var(--serif);
    font-size: 1.08rem;
    text-decoration: none;
    color: var(--accent);
    flex: none;
  }
  .ways a:hover { text-decoration: underline; text-underline-offset: 3px; }
  .ways span {
    font-family: var(--sans);
    font-size: 0.88rem;
    color: var(--ink-2);
  }
</style>

---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Matrix from '../components/Matrix.astro';
import PersonSlot from '../components/PersonSlot.astro';
import PostCover from '../components/PostCover.astro';
import Figure from '../components/Figure.astro';
import EmptyCells from '../components/figures/EmptyCells.astro';
import { SITE, CATEGORIES } from '../data/site';

/** 최근 글 3편. 홈에 사진이 들어오는 유일한 자리이자, 블로그로 가는 길이기도 하다. */
const recent = (await getCollection('insights'))
  .sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf())
  .slice(0, 3);
const day = (d: Date) => d.toISOString().slice(0, 10);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Course',
  name: `${SITE.curriculum} 커리큘럼`,
  description:
    '재무·회계 실무자를 위한 AI 활용 표준 커리큘럼. 6개 블록과 7개 업무 워크플로로 구성됩니다.',
  provider: { '@type': 'Organization', name: SITE.name, url: SITE.url },
  isAccessibleForFree: true,
  inLanguage: 'ko',
};
---

<Base schema={schema}>
  <!-- ① 히어로 -->
  <section class="section hero ruled">
    <div class="wrap">
      <h1>재무 AI 표준 커리큘럼.<br />전부 무료입니다.</h1>
      <p class="lede hero-sub">
        <span class="s">커리큘럼과 강의자료, 실습 데이터를 모두 공개합니다.</span>
        <span class="s">내려받아 혼자 공부하시는 데에는 비용이 들지 않습니다.</span>
      </p>
      <div class="btn-row">
        <a class="btn" href="/program">교육프로그램 보기</a>
        <a class="btn btn--ghost" href="/about">왜 이 일을 하는가</a>
      </div>
    </div>
  </section>

  <!-- ② 무엇을 만드는가 — 먼저 물건, 그다음 사람 -->
  <section class="section section--soft">
    <div class="wrap">
      <p class="eyebrow">커리큘럼 구조</p>
      <h2>재무 업무를 여섯 기능으로 나누고, 일곱 갈래 업무로 다시 묶습니다</h2>
      <p class="lede narrow">
        <span class="s">먼저 재무 업무를 여섯 기능으로 나눕니다.</span>
        <span class="s">AI에 맡길 일과 사람이 맡을 일이 여기서 갈립니다.</span>
        <span class="s">다음으로 그 기능을 세무나 결산처럼 실제 일하는 순서대로 늘어놓습니다.</span>
        <span class="s">기능 하나와 업무 하나가 만나면 실습 한 단위가 됩니다.</span>
      </p>
      <div class="mt">
        <Matrix />
      </div>
      <p class="small muted after">
        본문은 교육위원 검토를 마친 부분부터 올립니다. 검토를 받기로 해 놓고 먼저
        내보낼 수는 없습니다. → <a href="/program">교육프로그램</a>
      </p>
    </div>
  </section>

  <!-- ③ 왜 지금인가 -->
  <section class="section">
    <div class="wrap two">
      <div>
        <p class="eyebrow">설계 근거</p>
        <h2>기존 교육과정에서 공통으로 빠져 있던 세 가지</h2>
      </div>
      <div class="narrow">
        <p>
          해외 주요 과정 12개를 살펴봤습니다. 세 가지가 공통으로 빠져 있었습니다.
          결산·세무·감사 같은 회계 실무에 맞춘 모듈, 대사와 재계산으로 결과를
          확인하는 절차, 그리고 한국 제도에 대한 설명입니다.
        </p>
        <p>
          도구 사용법을 가르치는 과정은 이미 많습니다. 다만 재무 업무는 나온 결과가
          맞는지 확인하지 못하면 쓸 수 없습니다. 검증을 별도의 기능으로 세운
          이유입니다.
        </p>
        <p><a href="/insights">조사 자료 보기 →</a></p>
      </div>
    </div>
    <div class="prose fig-slot">
      <Figure
        label="조사"
        caption="해외 주요 과정 12개를 훑어 본 결과. 분석과 보고는 어디서나 다루지만, 데이터 확보와 제도권 실무, 검증은 공통으로 비어 있었습니다."
      >
        <EmptyCells />
      </Figure>
    </div>
  </section>

  <!-- ④ 누가 만드는가 -->
  <section class="section section--soft">
    <div class="wrap">
      <p class="eyebrow">운영 체계</p>
      <h2>설계와 검증을 분리합니다</h2>
      <p class="lede narrow">
        <span class="s">커리큘럼을 만든 사람이 스스로 점검하는 것으로는 부족합니다.</span>
        <span class="s">검증은 교육위원회에 맡깁니다.</span>
      </p>
      <div class="grid grid--2 who">
        <div class="card">
          <p class="eyebrow">만드는 사람</p>
          <PersonSlot
            name="박상정"
            affiliation="공인회계사"
            note="KICPA AI전문 교육, 세종대 AI재무분석 출강"
            photo="/images/person-hany.png"
          />
        </div>
        <div class="card">
          <p class="eyebrow">검증</p>
          <p class="pending"><strong>교육위원회 (구성 중)</strong></p>
          <p class="small muted">
            의견을 여쭙는 데서 그치지 않습니다. 커리큘럼의 어느 부분이든 덜어낼
            권한을 함께 드립니다. 정원은 7인입니다.
            <a href="/about/committee">교육위원회 →</a>
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 지향 -->
  <section class="section aims ruled">
    <div class="wrap">
      <p class="eyebrow">지향</p>
      <div class="aim-grid">
        <div class="aim">
          <p class="aim-t">조직에는 <strong>운영</strong>으로 남고</p>
          <p class="small muted">
            시연에서 끝나는 도입은 이미 많습니다. 결산 주기가 바뀌어도 같은 품질이
            나오고, 담당자가 바뀌어도 이어지는 데까지 가야 합니다.
          </p>
        </div>
        <div class="aim">
          <p class="aim-t">개인에게는 <strong>판단할 시간</strong>이 늘도록</p>
          <p class="small muted">
            옮겨 적고 대조하는 일이 줄면 판단과 설계가 남습니다.
            회계에서 가장 어려운 부분이 그쪽입니다.
          </p>
        </div>
      </div>
      <p class="aim-note small">
        두 가지는 같은 일의 양면입니다. 업무를 설계할 줄 아는 사람이 늘면 조직에서는
        한번 만든 방식이 다음 주기에도 그대로 돌아가고, 개인은 하는 일의 성격이 바뀝니다.
        <a href="/about">우리는 누구인가 →</a>
      </p>
    </div>
  </section>

  <!-- 최근 글 -->
  <section class="section recent">
    <div class="wrap">
      <div class="recent-head">
        <div>
          <p class="eyebrow">블로그</p>
          <h2 class="lead-h">최근에 쓴 글</h2>
        </div>
        <a class="more" href="/insights">전체 보기 →</a>
      </div>
      <ul class="posts">
        {
          recent.map((p) => (
            <li>
              <a href={`/insights/${p.id}`}>
                <PostCover src={p.data.cover} alt={p.data.coverAlt} />
                <p class="p-cat">{CATEGORIES[p.data.category].label}</p>
                <p class="p-title">{p.data.title}</p>
                <p class="p-lede small muted">{p.data.lede}</p>
                <time datetime={day(p.data.published)} class="p-date num small">
                  {day(p.data.published)}
                </time>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section join-band section--soft">
    <div class="wrap">
      <div class="jb">
        <div>
          <h2 class="lead-h">자료가 열리면 알려드립니다</h2>
          <p class="lede">
            <span class="s">읽는 데에는 가입이 필요하지 않습니다.</span>
            <span class="s">
              리터러시 12시간은 <strong>9월</strong>, 실무 24시간은 <strong>10월</strong>에 공개합니다.
            </span>
          </p>
        </div>
        <a class="btn" href="/join">가입하기</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero {
    padding-block: clamp(4rem, 10vw, 8.5rem) clamp(3.5rem, 7vw, 6rem);
    position: relative;
  }
  /* 격자를 위에서 아래로 서서히 지운다 — 지면 위 제도용지 같은 인상만 남기고 본문을 방해하지 않게 */
  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, transparent 20%, var(--bg) 92%);
    pointer-events: none;
  }
  .hero > * { position: relative; z-index: 1; }
  .hero h1 { text-wrap: balance; margin-bottom: 0.6em; }
  .hero-sub { max-width: 36rem; }

  .narrow { max-width: 40rem; }
  .mt { margin-top: 2rem; }
  .after { margin-top: 1.5rem; }

  .two { display: grid; gap: 1.5rem 3rem; align-items: start; }
  @media (min-width: 54rem) { .two { grid-template-columns: 20rem 1fr; } }
  .two h2 { margin-top: 0; }

  .who { margin-top: 2rem; }
  .who .eyebrow { margin-bottom: 0.9rem; }
  .pending { margin-bottom: 0.5rem; }

  .aims { position: relative; }
  .aim-grid { display: grid; gap: 2rem 3.5rem; }
  @media (min-width: 48rem) { .aim-grid { grid-template-columns: 1fr 1fr; } }
  .aim-t {
    font-size: clamp(1.25rem, 1.05rem + 0.9vw, 1.62rem);
    line-height: 1.5;
    font-weight: 400;
    margin: 0 0 0.7rem;
    padding-bottom: 0.7rem;
    border-bottom: 1px solid var(--line);
  }
  .aim-t strong { font-weight: 600; }
  .aim p:last-child { margin-bottom: 0; }
  .aim-note { margin: 2.5rem 0 0; max-width: 44rem; color: var(--ink-2); }

  /* 도해는 본문 폭에 맞춰 아래로 붙인다 — 두 단 배치를 흔들지 않는다 */
  .fig-slot { margin-top: 0.5rem; }
  .fig-slot :global(.fig) { margin-bottom: 0; }

  /* 최근 글 — 홈에서 사진이 들어오는 유일한 자리 */
  .recent-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem 2rem;
    flex-wrap: wrap;
  }
  .recent-head .lead-h { margin: 0; }
  .more { font-family: var(--sans); font-size: 0.9rem; font-weight: 600; flex: none; }

  .posts { list-style: none; margin: 2rem 0 0; padding: 0; display: grid; gap: 1.6rem; }
  @media (min-width: 50rem) { .posts { grid-template-columns: repeat(3, 1fr); } }
  .posts li { margin: 0; }
  .posts a { text-decoration: none; color: inherit; display: block; }
  .posts a:hover .p-title { text-decoration: underline; text-underline-offset: 3px; }
  .p-cat {
    font-family: var(--sans);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--brand);
    margin: 0.9rem 0 0.3rem;
  }
  .p-title { font-size: 1.08rem; font-weight: 600; line-height: 1.5; margin: 0 0 0.4rem; }
  .p-lede { margin: 0 0 0.5rem; }
  .p-date { color: var(--ink-3); font-family: var(--sans); }

  .join-band .lead-h { margin-top: 0; }
  .jb { display: flex; flex-wrap: wrap; gap: 1.5rem 2.5rem; align-items: center; justify-content: space-between; }
  .jb .lede { margin-bottom: 0; max-width: 36rem; }
  .jb .btn { flex: none; }
</style>

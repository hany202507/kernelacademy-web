---
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PhaseTimeline from '../../components/PhaseTimeline.astro';
import PostCover from '../../components/PostCover.astro';
import { SITE, CATEGORIES, AUTHOR } from '../../data/site';

export const getStaticPaths: GetStaticPaths = async () => {
  const posts = await getCollection('insights');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
};

const { post } = Astro.props;
const { Content } = await render(post);
const d = post.data;
const fmt = (x: Date) => x.toISOString().slice(0, 10);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: d.title,
  description: d.lede,
  datePublished: fmt(d.published),
  dateModified: fmt(d.updated),
  inLanguage: 'ko',
  author: { '@type': 'Person', name: AUTHOR.name, jobTitle: AUTHOR.title, url: AUTHOR.url },
  publisher: { '@type': 'Organization', name: SITE.name, url: SITE.url },
};

/**
 * FAQPage — 검색·AI 답변이 통째로 인용해 가는 자리다.
 * frontmatter 의 faq 가 원본이고 아래 섹션과 이 구조화데이터가 같은 것을 읽는다.
 */
const faqSchema =
  d.faq.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: d.faq.map((f) => ({
          '@type': 'Question',
          name: f.q,
          acceptedAnswer: { '@type': 'Answer', text: f.a },
        })),
      }
    : null;

const schemas = faqSchema ? [schema, faqSchema] : schema;
---

<Base title={d.title} description={d.lede} schema={schemas} image={d.cover}>
  <section class="section section--tint pagehead">
    <div class="prose">
      <p class="eyebrow">
        <a href="/insights" class="cat-link">
          {CATEGORIES[d.category].label}
        </a>
        <span class="stage">{d.stage}에서 쓰입니다</span>
      </p>
      <h1>{d.title}</h1>
      <p class="lede">{d.lede}</p>
      {/* 누가 언제 썼고 언제 고쳤는지. 화면에 없으면 신뢰 신호로 세지 못한다. */}
      <p class="byline small">
        <strong>{AUTHOR.name}</strong> <span class="muted">{AUTHOR.title}</span>
        <span class="sep">·</span>
        <time datetime={fmt(d.published)} class="num muted">{fmt(d.published)} 발행</time>
        <span class="sep">·</span>
        <time datetime={fmt(d.updated)} class="num muted">{fmt(d.updated)} 최종 수정</time>
      </p>
      <p class="bio small muted">{AUTHOR.bio} <a href={AUTHOR.url}>소개</a></p>
    </div>
  </section>

  {
    d.cover && (
      <div class="hero-img">
        <div class="prose-wide">
          <PostCover src={d.cover} alt={d.coverAlt} wide eager />
        </div>
      </div>
    )
  }

  <article class="section article-body">
    <div class="prose">
      {
        d.tldr.length > 0 && (
          <aside class="tldr" aria-label="세 줄 요약">
            <p class="tldr-h">세 줄 요약</p>
            <ul>
              {d.tldr.map((t) => (
                <li>{t}</li>
              ))}
            </ul>
          </aside>
        )
      }

      <div class="body">
        <Content components={{ PhaseTimeline }} />
      </div>

      {
        d.faq.length > 0 && (
          <section class="faq">
            <h2>자주 받는 질문</h2>
            <dl>
              {d.faq.map((f) => (
                <>
                  <dt>{f.q}</dt>
                  <dd>{f.a}</dd>
                </>
              ))}
            </dl>
          </section>
        )
      }

      {
        d.sources.length > 0 && (
          <section class="sources">
            <h2>출처</h2>
            <ol>
              {d.sources.map((s) => (
                <li>
                  <strong>{s.label}</strong>
                  {/* 구분에 줄표를 쓰지 않는다. 출처가 여러 건이면 한 화면에
                      대시가 그 수만큼 쌓인다. 중점이 한국어 표기 관습에 맞다. */}
                  {s.note && <span class="muted"> · {s.note}</span>}
                </li>
              ))}
            </ol>
          </section>
        )
      }

      <p class="back"><a href="/insights">← 블로그 전체 보기</a></p>
    </div>
  </article>
</Base>

<style>
  .pagehead { padding-bottom: clamp(2rem, 3.5vw, 2.75rem); }
  /* 사진이 머리말 띠와 본문 사이에 걸치게 둔다 — 띠가 사진 뒤로 이어져 보인다 */
  .hero-img { background: linear-gradient(to bottom, var(--tint-soft) 55%, var(--bg) 55%); }
  .article-body { padding-top: clamp(2.5rem, 5vw, 4rem); }
  .eyebrow { display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap; }
  .stage {
    font-weight: 500;
    letter-spacing: 0.02em;
    text-transform: none;
    color: var(--brand);
    background: color-mix(in srgb, var(--brand) 9%, var(--bg));
    border-radius: 999px;
    padding: 0.15em 0.6em;
  }
  .cat-link { text-decoration: none; color: var(--ink-3); }
  .cat-link:hover { color: var(--brand); }
  .meta { display: flex; gap: 0.5rem; margin-bottom: 0; }
  .body > :global(:first-child) { margin-top: 0; }

  /* 본문 표는 넘침 처리를 바깥 div(.md-table)가 맡는다 — 표에 직접 걸면 열 너비가 깨진다.
     읽는 데 유리하도록 본문 폭보다 넓게 빼낸다. 도해(.fig--bleed)와 같은 폭. */
  .body :global(.md-table) { margin: 2rem 0; }
  @media (min-width: 58rem) {
    .body :global(.md-table) {
      width: 52rem;
      max-width: none; /* .table-wrap 의 max-width:100% 를 푼다 — 안 그러면 본문 폭에 갇힌다 */
      margin-inline: calc((42rem - 52rem) / 2);
    }
  }
  .body :global(h2) { scroll-margin-top: 5rem; }
  .body :global(img) { max-width: 100%; height: auto; }

  .byline { display: flex; flex-wrap: wrap; gap: 0.4rem; align-items: baseline; margin-bottom: 0.35rem; }
  .byline .sep { color: var(--ink-3); }
  .bio { margin-bottom: 0; max-width: 34rem; line-height: 1.6; }

  /* 첫 화면에 결론을 놓는 자리. 본문보다 먼저 읽히도록 지면을 준다. */
  .tldr {
    margin: 0 0 2.5rem;
    padding: 1.1rem 1.35rem;
    border-left: 3px solid var(--brand);
    background: var(--tint-soft);
    border-radius: 0 3px 3px 0;
  }
  .tldr-h {
    margin: 0 0 0.6rem;
    font-family: var(--sans);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--brand);
  }
  .tldr ul { margin: 0; padding-left: 1.1rem; }
  .tldr li { margin-bottom: 0.4em; line-height: 1.65; }
  .tldr li:last-child { margin-bottom: 0; }

  .faq { margin-top: 3.5rem; }
  .faq > h2 { font-size: 1.35rem; margin-bottom: 1.25rem; }
  .faq dl { margin: 0; }
  .faq dt {
    font-weight: 600;
    color: var(--ink);
    margin-top: 1.6rem;
    padding-top: 1.6rem;
    border-top: 1px solid var(--line-soft);
    line-height: 1.5;
  }
  .faq dt:first-of-type { margin-top: 0; padding-top: 0; border-top: 0; }
  .faq dd { margin: 0.55rem 0 0; color: var(--ink-2); line-height: 1.75; }

  .sources {
    margin-top: 3.5rem;
    padding: 1.35rem 1.5rem;
    border: 1px solid var(--line);
    border-radius: 3px;
    background: var(--bg-soft);
    font-size: 0.92rem;
  }
  .sources h2 { margin: 0 0 0.75rem; font-size: 0.85rem; letter-spacing: 0.06em; color: var(--ink-2); }
  .sources ol { margin: 0; padding-left: 1.2rem; }
  .sources li { margin-bottom: 0.45em; line-height: 1.6; }

  .back { margin-top: 3rem; }
</style>

---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PostCover from '../../components/PostCover.astro';
import { CATEGORIES } from '../../data/site';

/**
 * 최신 글이 먼저. 같은 날 올린 글끼리는 order 로 갈라 연재 순서를 지킨다
 * (1편이 4편보다 위에 오게).
 */
const posts = (await getCollection('insights')).sort(
  (a, b) => b.data.published.valueOf() - a.data.published.valueOf() || a.data.order - b.data.order
);
const fmt = (d: Date) => d.toISOString().slice(0, 10);

/**
 * 탭은 라디오 + 라벨로 만든다. JS 가 없어도 동작하고, 모든 탭의 글이 HTML 에
 * 남아 있어 크롤러와 LLM 이 한 번에 읽는다. 키보드 이동도 라디오 기본 동작으로 된다.
 */
const 주제 = (Object.entries(CATEGORIES) as [keyof typeof CATEGORIES, (typeof CATEGORIES)[keyof typeof CATEGORIES]][]).map(
  ([name, c]) => ({
    ...c,
    name,
    posts: posts.filter((p) => p.data.category === name),
  })
);

const TABS = [{ key: 'all', label: '전체', n: posts.length }, ...주제.map((g) => ({ key: g.key, label: g.label, n: g.posts.length }))];

---

<Base
  title="블로그"
  description="재무 실무를 실제로 바꾸는 변화만 골라 정리하고, 다른 조직이 어떤 순서로 시작해 어디서 막혔는지 기록합니다. 출처와 조사일을 함께 답니다."
>
  <section class="section section--tint head">
    <div class="prose">
      <p class="eyebrow">블로그</p>
      <h1>반년마다 다시 배우게 되는 분야입니다</h1>
      <p class="lede">
        <span class="s">이 분야는 반년마다 도구가 바뀝니다.</span>
        <span class="s">처음 배우는 것보다 배운 것을 계속 쓸 수 있게 유지하는 일이 더 오래 걸립니다.</span>
      </p>
      <p class="lede">
        <span class="s">매주 쏟아지는 소식 가운데 재무 실무를 실제로 바꾸는 것은 많지 않습니다.</span>
        <span class="s">정작 필요한 자료는 영문으로 흩어져 있습니다.</span>
        <span class="s">그래서 실무에 닿는 것만 골라 우리말로 정리하고, 언제 기준의 이야기인지 아실 수 있도록 출처와 조사일을 함께 답니다.</span>
      </p>
    </div>
  </section>

  <section class="section section--soft list">
    <div class="prose-wide">
      <fieldset class="tabs">
        <legend class="sr-only">글 분류 선택</legend>

        {
          TABS.map((t, i) => (
            <input class="tab-radio" type="radio" name="cat" id={`tab-${t.key}`} checked={i === 0} />
          ))
        }

        <div class="tablist">
          {
            TABS.map((t) => (
              <label class="tab" for={`tab-${t.key}`}>
                {t.label}
                <span class="tab-n num">{t.n}</span>
              </label>
            ))
          }
        </div>

        <div class="blurbs">
          <p class="blurb blurb--all">
            세 가지 주제를 한곳에 모았습니다. 위에서 보고 싶은 주제만 골라 보실 수
            있습니다.
          </p>
          <p class="blurb blurb--trend">
            새 도구가 나올 때마다 배워야 하는 것은 아닙니다. 지금 익힐 것과 기다려도
            될 것을 나눠 적습니다.
          </p>
          <p class="blurb blurb--case">
            다른 조직이 어디서부터 손댔고 몇 달째에 무엇에 막혔는지 순서대로 적습니다.
            개념보다 이쪽이 옮겨 쓰기 쉽습니다.
          </p>
          <p class="blurb blurb--career">
            취업과 채용 양쪽에서 봅니다. 지원자로서 무엇을 준비해야 하는지, 뽑는 쪽에서
            무엇을 물어야 하는지 함께 다룹니다.
          </p>
        </div>

        <ul class="posts">
          {
            posts.map((p) => (
              <li class:list={['post', `post--${CATEGORIES[p.data.category].key}`]}>
                <a href={`/insights/${p.id}`} class="post-link">
                  <PostCover src={p.data.cover} alt={p.data.coverAlt} />
                  <p class="post-cat">{CATEGORIES[p.data.category].label}</p>
                  <h2>{p.data.title}</h2>
                  <p class="post-lede">{p.data.lede}</p>
                  <p class="post-meta">
                    <time datetime={fmt(p.data.published)} class="num">{fmt(p.data.published)}</time>
                  </p>
                </a>
              </li>
            ))
          }
        </ul>

        {
          주제
            .filter((g) => g.posts.length === 0)
            .map((g) => (
              <p class:list={['empty', `empty--${g.key}`]}>
                {/* 조사를 붙이지 않는다. 주제 이름의 받침이 제각각이라
                    「은/는」을 하드코딩하면 「재무AX 성공사례은」이 된다. */}
                <strong>{g.label}</strong> — 아직 글이 없습니다. 첫 글을 쓰는 대로 여기에 올립니다.
              </p>
            ))
        }
      </fieldset>
    </div>
  </section>
</Base>

<style>
  /* 머리말 문단은 크기를 하나로 맞춘다 — 셋이 조금씩 다르면 읽는 리듬이 끊긴다 */
  .head { padding-bottom: clamp(2rem, 4vw, 3rem); }
  .head .lede { max-width: 40rem; }
  .head .lede:last-child { margin-bottom: 0; }
  .list { padding-top: clamp(2rem, 4vw, 3rem); }

  .tabs { border: 0; margin: 0; padding: 0; min-width: 0; }

  /* 라디오는 화면에서 숨기되 포커스는 살린다 — 라벨을 탭처럼 쓰기 위한 장치 */
  .tab-radio { position: absolute; opacity: 0; width: 1px; height: 1px; pointer-events: none; }

  .tablist {
    display: flex;
    gap: 0.35rem;
    flex-wrap: wrap;
    border-bottom: 1px solid var(--line);
  }
  .tab {
    font-family: var(--sans);
    font-size: 0.93rem;
    font-weight: 500;
    color: var(--ink-2);
    padding: 0.72em 1.05em;
    cursor: pointer;
    border: 1px solid transparent;
    border-bottom: 0;
    margin-bottom: -1px;
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    white-space: nowrap;
    transition: color 0.12s, background 0.12s;
  }
  .tab:hover { color: var(--ink); }
  .tab-n {
    font-size: 0.76rem;
    color: var(--ink-3);
    background: var(--bg-deep);
    border-radius: 999px;
    padding: 0.1em 0.5em;
    line-height: 1.6;
  }

  /* 선택된 탭 — 지면에서 종이 한 장이 앞으로 나온 모양 */
  #tab-all:checked ~ .tablist .tab[for='tab-all'],
  #tab-trend:checked ~ .tablist .tab[for='tab-trend'],
  #tab-case:checked ~ .tablist .tab[for='tab-case'],
  #tab-career:checked ~ .tablist .tab[for='tab-career'] {
    color: var(--ink);
    font-weight: 600;
    background: var(--bg);
    border-color: var(--line);
  }
  #tab-all:checked ~ .tablist .tab[for='tab-all'] .tab-n,
  #tab-trend:checked ~ .tablist .tab[for='tab-trend'] .tab-n,
  #tab-case:checked ~ .tablist .tab[for='tab-case'] .tab-n,
  #tab-career:checked ~ .tablist .tab[for='tab-career'] .tab-n {
    background: var(--accent);
    color: #fff;
  }
  #tab-all:focus-visible ~ .tablist .tab[for='tab-all'],
  #tab-trend:focus-visible ~ .tablist .tab[for='tab-trend'],
  #tab-case:focus-visible ~ .tablist .tab[for='tab-case'],
  #tab-career:focus-visible ~ .tablist .tab[for='tab-career'] {
    outline: 2px solid var(--accent);
    outline-offset: -2px;
  }

  .blurbs { margin: 1.6rem 0 0; }
  .blurb { display: none; margin: 0; color: var(--ink-2); font-size: 0.97rem; max-width: 44rem; }
  #tab-all:checked ~ .blurbs .blurb--all,
  #tab-trend:checked ~ .blurbs .blurb--trend,
  #tab-case:checked ~ .blurbs .blurb--case,
  #tab-career:checked ~ .blurbs .blurb--career { display: block; }

  /* 카드 — 썸네일 위, 글 아래. 테두리를 두르지 않고 지면에 그대로 얹는다 */
  .posts {
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
    display: grid;
    gap: 2.5rem 2rem;
  }
  @media (min-width: 40rem) { .posts { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 62rem) { .posts { grid-template-columns: repeat(3, 1fr); } }
  .post { margin: 0; }

  /* 선택한 주제만 남긴다 */
  #tab-trend:checked ~ .posts .post:not(.post--trend),
  #tab-case:checked ~ .posts .post:not(.post--case),
  #tab-career:checked ~ .posts .post:not(.post--career) { display: none; }

  /* 아직 글이 없는 주제 — 비어 있는 것을 비어 있다고 둔다 */
  .empty {
    display: none;
    margin: 2rem 0 0;
    padding: 1.15rem 1.35rem;
    border: 1px dashed var(--ink-3);
    border-radius: 3px;
    color: var(--ink-2);
    font-size: 0.95rem;
  }
  #tab-trend:checked ~ .empty--trend,
  #tab-case:checked ~ .empty--case,
  #tab-career:checked ~ .empty--career { display: block; }

  .post-link { display: block; text-decoration: none; color: inherit; }
  .post-link:hover :global(.cover) { border-color: var(--ink-3); }

  .post-cat {
    font-family: var(--sans);
    font-size: 0.73rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    color: var(--ink-3);
    margin: 1.1rem 0 0.45rem;
  }
  .post-link h2 {
    margin: 0 0 0.6rem;
    font-size: 1.22rem;
    line-height: 1.5;
    font-weight: 600;
    text-wrap: pretty;
  }
  .post-link:hover h2 { color: var(--accent); }

  /* 제목·요약은 줄 수를 고정해 카드 높이를 맞춘다 */
  .post-lede {
    margin: 0 0 0.9rem;
    color: var(--ink-2);
    font-size: 0.95rem;
    line-height: 1.75;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    overflow: hidden;
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    margin: 0;
    font-family: var(--sans);
    font-size: 0.76rem;
    color: var(--ink-3);
  }
</style>

---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PostCover from '../../components/PostCover.astro';

const posts = (await getCollection('insights')).sort((a, b) => a.data.order - b.data.order);
const trend = posts.filter((p) => p.data.category === '트렌드');
const cases = posts.filter((p) => p.data.category === '사례');

const fmt = (d: Date) => d.toISOString().slice(0, 10);

/**
 * 탭은 라디오 + 라벨로 만든다. JS 가 없어도 동작하고, 세 탭의 글이 전부 HTML 에
 * 들어 있어 크롤러와 LLM 이 한 번에 읽는다. 키보드 이동도 라디오 기본 동작으로 된다.
 */
const TABS = [
  { id: 'all', label: '전체', n: posts.length },
  { id: 'trend', label: 'AI 트렌드', n: trend.length },
  { id: 'case', label: '재무AX 성공사례', n: cases.length },
];
---

<Base
  title="블로그"
  description="배운 것을 계속 쓸 수 있게. 재무 실무를 실제로 바꾸는 변화만 가려서 정리하고, 다른 조직이 어떤 순서로 시작해 어디서 막혔는지 기록합니다."
>
  <section class="section section--tint head">
    <div class="prose">
      <p class="eyebrow">블로그</p>
      <h1>한 번 배우고 끝나는 분야가 아닙니다</h1>
      <p class="lede">
        재무 AI는 반년이면 도구도 방법도 바뀝니다.
        <strong>배운 것을 계속 쓸 수 있게 유지하는 일</strong>이 배우는 일만큼 큽니다.
      </p>
      <p class="lede">
        매주 쏟아지는 소식 중 재무 실무를 실제로 바꾸는 것은 많지 않고, 정작 필요한 자료는
        영문으로 흩어져 있습니다. <strong>그걸 대신 골라 정리합니다.</strong>
        언제 기준의 이야기인지 알 수 있도록 출처와 조사일을 함께 답니다.
      </p>
    </div>
  </section>

  <section class="section section--soft list">
    <div class="prose-wide">
      <fieldset class="tabs">
        <legend class="sr-only">글 분류 선택</legend>

        {
          TABS.map((t, i) => (
            <input
              class="tab-radio"
              type="radio"
              name="cat"
              id={`tab-${t.id}`}
              checked={i === 0}
            />
          ))
        }

        <div class="tablist">
          {
            TABS.map((t) => (
              <label class="tab" for={`tab-${t.id}`}>
                {t.label}
                <span class="tab-n num">{t.n}</span>
              </label>
            ))
          }
        </div>

        <div class="blurbs">
          <p class="blurb blurb--all">두 갈래를 함께 봅니다.</p>
          <p class="blurb blurb--trend">
            새 도구가 나올 때마다 배워야 하는 것은 아닙니다.
            <strong>지금 익힐 것과 기다려도 될 것</strong>을 갈라 적습니다.
          </p>
          <p class="blurb blurb--case">
            개념을 알아도 어디부터 손댈지는 별개 문제입니다.
            다른 조직이 어떤 순서로 시작했고 <strong>어디서 막혔는지</strong>까지 적습니다.
          </p>
        </div>

        <ul class="posts">
          {
            posts.map((p) => (
              <li class:list={['post', p.data.category === '트렌드' ? 'post--trend' : 'post--case']}>
                <a href={`/insights/${p.id}`} class="post-link">
                  <PostCover src={p.data.cover} alt={p.data.coverAlt} />
                  <p class="post-cat">
                    {p.data.category === '트렌드' ? 'AI 트렌드' : '재무AX 성공사례'}
                  </p>
                  <h2>{p.data.title}</h2>
                  <p class="post-lede">{p.data.lede}</p>
                  <p class="post-meta">
                    <time datetime={fmt(p.data.published)} class="num">{fmt(p.data.published)}</time>
                    {p.data.sources.length > 0 && (
                      <span class="num">출처 {p.data.sources.length}건</span>
                    )}
                  </p>
                </a>
              </li>
            ))
          }
        </ul>
      </fieldset>
    </div>
  </section>
</Base>

<style>
  /* 머리말 문단은 크기를 하나로 맞춘다 — 셋이 조금씩 다르면 읽는 리듬이 끊긴다 */
  .head { padding-bottom: clamp(2rem, 4vw, 3rem); }
  .head .lede { max-width: 40rem; }
  .head .lede:last-child { margin-bottom: 0; }
  .list { padding-top: clamp(2rem, 4vw, 3rem); }

  .tabs { border: 0; margin: 0; padding: 0; min-width: 0; }

  /* 라디오는 화면에서 숨기되 포커스는 살린다 — 라벨을 탭처럼 쓰기 위한 장치 */
  .tab-radio {
    position: absolute;
    opacity: 0;
    width: 1px;
    height: 1px;
    pointer-events: none;
  }

  .tablist {
    display: flex;
    gap: 0.35rem;
    flex-wrap: wrap;
    border-bottom: 1px solid var(--line);
  }
  .tab {
    font-family: var(--sans);
    font-size: 0.93rem;
    font-weight: 500;
    color: var(--ink-2);
    padding: 0.72em 1.05em;
    cursor: pointer;
    border: 1px solid transparent;
    border-bottom: 0;
    margin-bottom: -1px;
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    white-space: nowrap;
    transition: color 0.12s, background 0.12s;
  }
  .tab:hover { color: var(--ink); }
  .tab-n {
    font-size: 0.76rem;
    color: var(--ink-3);
    background: var(--bg-deep);
    border-radius: 999px;
    padding: 0.1em 0.5em;
    line-height: 1.6;
  }

  /* 선택된 탭 — 지면에서 종이 한 장이 앞으로 나온 모양 */
  #tab-all:checked ~ .tablist .tab[for='tab-all'],
  #tab-trend:checked ~ .tablist .tab[for='tab-trend'],
  #tab-case:checked ~ .tablist .tab[for='tab-case'] {
    color: var(--ink);
    font-weight: 600;
    background: var(--bg);
    border-color: var(--line);
  }
  #tab-all:checked ~ .tablist .tab[for='tab-all'] .tab-n,
  #tab-trend:checked ~ .tablist .tab[for='tab-trend'] .tab-n,
  #tab-case:checked ~ .tablist .tab[for='tab-case'] .tab-n {
    background: var(--accent);
    color: #fff;
  }
  /* 키보드 포커스가 보이게 */
  .tab-radio:focus-visible ~ .tablist .tab[for='tab-all'],
  .tab-radio:focus-visible ~ .tablist .tab { outline: none; }
  #tab-all:focus-visible ~ .tablist .tab[for='tab-all'],
  #tab-trend:focus-visible ~ .tablist .tab[for='tab-trend'],
  #tab-case:focus-visible ~ .tablist .tab[for='tab-case'] {
    outline: 2px solid var(--accent);
    outline-offset: -2px;
  }

  .blurbs { margin: 1.6rem 0 0; }
  .blurb { display: none; margin: 0; color: var(--ink-2); font-size: 0.97rem; max-width: 44rem; }
  #tab-all:checked ~ .blurbs .blurb--all,
  #tab-trend:checked ~ .blurbs .blurb--trend,
  #tab-case:checked ~ .blurbs .blurb--case { display: block; }

  /* 카드 — 썸네일 위, 글 아래. 테두리를 두르지 않고 지면에 그대로 얹는다 */
  .posts {
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
    display: grid;
    gap: 2.5rem 2rem;
  }
  @media (min-width: 40rem) { .posts { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 62rem) { .posts { grid-template-columns: repeat(3, 1fr); } }
  .post { margin: 0; }
  #tab-trend:checked ~ .posts .post--case,
  #tab-case:checked ~ .posts .post--trend { display: none; }

  .post-link { display: block; text-decoration: none; color: inherit; }
  .post-link:hover :global(.cover) { border-color: var(--ink-3); }

  .post-cat {
    font-family: var(--sans);
    font-size: 0.73rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    color: var(--ink-3);
    margin: 1.1rem 0 0.45rem;
  }
  .post-link h2 {
    margin: 0 0 0.6rem;
    font-size: 1.22rem;
    line-height: 1.5;
    font-weight: 600;
    text-wrap: pretty;
  }
  .post-link:hover h2 { color: var(--accent); }

  /* 제목·요약은 줄 수를 고정해 카드 높이를 맞춘다 */
  .post-lede {
    margin: 0 0 0.9rem;
    color: var(--ink-2);
    font-size: 0.95rem;
    line-height: 1.75;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    overflow: hidden;
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    margin: 0;
    font-family: var(--sans);
    font-size: 0.76rem;
    color: var(--ink-3);
  }
  /* 글을 커리큘럼에 걸어 두는 표시 */
  .stage {
    font-weight: 500;
    color: var(--brand);
    background: color-mix(in srgb, var(--brand) 9%, var(--bg));
    border-radius: 999px;
    padding: 0.2em 0.65em;
  }
</style>
